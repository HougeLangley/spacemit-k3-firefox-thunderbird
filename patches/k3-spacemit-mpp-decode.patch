@@ -670,10 +670,21 @@ void PDMFactory::CreateRddPDMs() {
     const bool preferSystemForVulkan =
         gfx::gfxVars::CanUseVulkanHardwareVideoDecoding() &&
         FFmpegRuntimeLinker::PreferSystemFFmpegForVulkan();
+#if defined(__riscv)
+    // K3's SpacemiT MPP decoders live in system FFmpeg. Select that PDM
+    // before the bundled software FFVPX PDM whenever hardware decoding is
+    // enabled. FFVPX remains available for AV1 and unsupported codecs.
+    const bool preferSystemForRiscV =
+        StaticPrefs::media_hardware_video_decoding_enabled_AtStartup();
+#else
+    const bool preferSystemForRiscV = false;
+#endif
+    const bool preferSystemFFmpeg =
+        preferSystemForVulkan || preferSystemForRiscV;
     PDM_INIT_LOG("Insert system FFmpeg before ffvpx: {}",
-                 preferSystemForVulkan);
+                 preferSystemFFmpeg);
     if (!StartupPDM(FFmpegRuntimeLinker::CreateDecoder(),
-                    preferSystemForVulkan)) {
+                    preferSystemFFmpeg)) {
       mFailureFlags += GetFailureFlagBasedOnFFmpegStatus(
           FFmpegRuntimeLinker::LinkStatusCode());
     }
